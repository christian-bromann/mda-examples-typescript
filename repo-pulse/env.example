# LangSmith — required to deploy / bake managed sandboxes.
LANGSMITH_API_KEY=
# LANGSMITH_WORKSPACE_ID=

# Model provider (must match agent.ts).
OPENAI_API_KEY=

# Trusted-backend / Studio loopback secret.
MDA_INGRESS_SECRET=

# GitHub — PAT with read access to the repos you analyze.
# Fine-grained: Contents (read) + Issues (read) + Pull requests (read) is enough
# for public repos; private repos need repository access granted to the token.
GITHUB_TOKEN=

# Docker Hub — access token for the private sandbox image.
# Create at https://hub.docker.com/settings/security (Read-only is enough for bake).
# Mark christianbromann/mda-repo-pulse as Private on Docker Hub.
DOCKERHUB_TOKEN=

# Optional UI default (owner/repo). Defaults to langchain-ai/langchain.
# VITE_DEFAULT_REPO=langchain-ai/langchain
