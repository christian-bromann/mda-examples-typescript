{
  "name": "mda-example-repo-pulse-ts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Repo Pulse — GitHub maintainer analytics with a baked pandas/matplotlib sandbox and chart UI.",
  "scripts": {
    "dev": "run-p dev:agent dev:ui",
    "dev:agent": "mda dev . --no-browser",
    "dev:ui": "vite --port 4911",
    "build:ui": "vite build",
    "build:sandbox": "docker buildx build --platform linux/amd64 --provenance=false --sbom=false -t christianbromann/mda-repo-pulse:0.1.1 --push ./sandbox",
    "login:sandbox": "printf '%s\\n' \"$DOCKERHUB_TOKEN\" | docker login -u christianbromann --password-stdin",
    "deploy": "mda deploy .",
    "typecheck": "tsc --noEmit -p tsconfig.agent.json && tsc --noEmit -p tsconfig.app.json"
  },
  "dependencies": {
    "@langchain/core": "1.2.8",
    "@langchain/react": "^1.0.18",
    "@octokit/rest": "^22.0.1",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@radix-ui/react-use-controllable-state": "^1.2.2",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "ai": "^6.0.191",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "langchain": "1.5.4",
    "lucide-react": "^1.16.0",
    "managed-deepagents": "0.5.4-dev.4",
    "motion": "^12.40.0",
    "nanoid": "^5.1.11",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "shiki": "^4.1.0",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "npm-run-all2": "^8.0.4",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.14"
  },
  "overrides": {
    "@langchain/core": "1.2.8",
    "langchain": "1.5.4"
  }
}
