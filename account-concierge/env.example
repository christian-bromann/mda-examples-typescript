# Model provider (must match agent.ts) — required for local runs.
OPENAI_API_KEY=

# Shared secret for trusted-backend ingress — required for local runs.
# Same value in mda dev / deploy AND in the proxy process.
# Never send this from the browser.
MDA_INGRESS_SECRET=

# LangSmith — only needed for `mda deploy` (and LangGraph Studio).
# Not required for the local proxy demo.
# LANGSMITH_API_KEY=
# LANGSMITH_WORKSPACE_ID=

# Optional: where the proxy forwards LangGraph traffic.
# Default is http://[::1]:2024 (langgraph-cli often binds IPv6 only).
# LANGGRAPH_API_URL=http://[::1]:2024
# PROXY_PORT=4910
