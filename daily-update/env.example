# LangSmith — required to deploy / use managed sandboxes.
LANGSMITH_API_KEY=
# LANGSMITH_WORKSPACE_ID=

# Model provider (must match agent.ts).
OPENAI_API_KEY=

# GitHub PAT for your account (used by authored GitHub tools).
# Classic `repo` (+ org SSO) recommended so private and public activity both show up.
GITHUB_TOKEN=

# Linear personal API key (used by authored Linear tools).
# Create at https://linear.app/settings/account/security — acts as your user.
LINEAR_API_KEY=

# Trusted-backend / channel loopback secret.
MDA_INGRESS_SECRET=

# Slack bot — Events + schedule DM delivery only.
# Events URL after deploy: https://<deployment>/channels/slack/events
# Bot scopes: chat:write, im:write, im:history, app_mentions:read, users:read
# Subscribe to: message.im, app_mention
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Slack user token — authored Slack tools for digest framing (search/history).
# Must be a user token (`xoxp-…`), not SLACK_BOT_TOKEN. Bot tokens fail
# search.messages with not_allowed_token_type. See docs/slack-user-token.md.
SLACK_USER_TOKEN=
