# LangSmith — required to deploy / for sandboxes.
LANGSMITH_API_KEY=
# LANGSMITH_WORKSPACE_ID=

# Model provider (must match agent.ts).
OPENAI_API_KEY=

# Signs Connect OAuth state JWTs (name is historical; still required by identity).
MDA_GUEST_SIGNING_KEY=

# Supabase project for agent JWT verification (identity.ts).
# Optional if VITE_SUPABASE_URL is set — projectRef is parsed from the host.
# SUPABASE_PROJECT_REF=your-project-ref
# SUPABASE_URL=https://your-project-ref.supabase.co

# --- Frontend (Vite) — publishable keys only ---
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=

# Point UI at a remote LangSmith MDA deployment.
# Required for Cloudflare (`npm run deploy:ui`). Leave unset for local Vite proxy.
# VITE_LANGGRAPH_API_URL=https://your-deployment.langsmith.app
VITE_LANGGRAPH_ASSISTANT_ID=sandbox-assistant
