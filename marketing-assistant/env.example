# LangSmith — required to deploy.
LANGSMITH_API_KEY=
# LANGSMITH_WORKSPACE_ID=

# Model provider (must match agent.ts).
OPENAI_API_KEY=

# Trusted-backend / channel loopback secret.
MDA_INGRESS_SECRET=

# Slack bot — Events + schedule DM delivery.
# Events URL after deploy: https://<deployment>/channels/slack/events
# Bot scopes: chat:write, im:write, im:history, app_mentions:read, users:read
# Subscribe to: message.im, app_mention
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# --- Optional research sources ---
# Hacker News needs no credentials (public Algolia API).

# X (Twitter) — read-only search/timeline. See docs/x-api-setup.md
# X_BEARER_TOKEN=
