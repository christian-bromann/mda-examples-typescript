# LangSmith — required to deploy / for sandboxes.
LANGSMITH_API_KEY=
# LANGSMITH_WORKSPACE_ID=

# Model provider (must match agent.ts).
OPENAI_API_KEY=

# Signs Connect OAuth state JWTs (name is historical; still required by identity).
MDA_GUEST_SIGNING_KEY=

# Supabase project for agent JWT verification (identity.ts).
# Optional if VITE_SUPABASE_URL is set — projectRef is parsed from the host.
# SUPABASE_PROJECT_REF=your-project-ref
# SUPABASE_URL=https://your-project-ref.supabase.co

# --- Frontend (Vite) — publishable keys only ---
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=

# Point UI at a remote LangSmith MDA deployment.
# Required for Cloudflare (`npm run deploy` / `deploy:ui`). Leave unset for local Vite proxy.
#
# Chicken-and-egg: this URL only exists after you deploy the agent once
# (`npm run deploy:agent`). In LangSmith, open the deployment and copy its
# API URL / Resource URL (not the dashboard link), e.g.:
#   https://your-deployment.us.langsmith.app
#
# Same name for local `.env` and the GitHub Actions repo secret.
# POLICY_DESK_DEPLOYMENT_API=https://your-deployment.us.langsmith.app

# --- Cloudflare (wrangler) — required for `npm run deploy` / `deploy:ui` ---
# Create a token with Workers Scripts Edit (or Account → Workers Scripts → Edit).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
